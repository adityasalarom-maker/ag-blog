# ==============================================================================
# Antigravity Review — Environment Configuration Template
# ==============================================================================
# Security Notice:
# 1. NEVER commit production secrets, write tokens, or private keys to Git.
# 2. Confidential copyright evidence, identity documents, and private correspondence
#    must NEVER be uploaded to public datasets or unauthenticated CMS media buckets.
# ==============================================================================

# Content Source Mode:
# 'local'  -> Uses local validated Content Layer and seed JSON files (Default for dev/testing)
# 'sanity' -> Connects to Sanity.io Headless CMS via GROQ API
CONTENT_SOURCE=local

# Sanity Headless CMS Configuration (Required when CONTENT_SOURCE=sanity)
SANITY_PROJECT_ID=placeholder_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-14
SANITY_USE_CDN=true

# Optional: Sanity Read Token (Only needed if querying private draft datasets for preview)
# DO NOT expose write tokens or admin tokens to client-side bundles!
SANITY_READ_TOKEN=placeholder_read_token

# Site Base URL (used for canonical URLs, Open Graph tags, and sitemaps)
PUBLIC_SITE_URL=https://ag-literary-publication.pages.dev
