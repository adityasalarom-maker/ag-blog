---
import { PUBLICATION_INFO } from '../data/fixtures';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: About the Publication -->
      <div class="footer-col col-brand">
        <h2 class="footer-brand">{PUBLICATION_INFO.name}</h2>
        <span class="footer-brand-hi">{PUBLICATION_INFO.nameHi}</span>
        <p class="footer-desc">{PUBLICATION_INFO.description}</p>
        <p class="footer-curator">Edited & Published by <strong>{PUBLICATION_INFO.editor}</strong></p>
      </div>

      <!-- Col 2: Literary Sections -->
      <div class="footer-col">
        <h3 class="footer-heading">Literary Sections</h3>
        <ul class="footer-links">
          <li><a href="/poetry">Poetry Anthology (कविता)</a></li>
          <li><a href="/prose">Stories & Essays (कथा व निबंध)</a></li>
          <li><a href="/thoughts">Aphorisms & Quotes (विचार)</a></li>
          <li><a href="/gallery">Visual Art & Craft (कला वीथिका)</a></li>
          <li><a href="/collections">Curated Collections (संग्रह)</a></li>
        </ul>
      </div>

      <!-- Col 3: Publication & Rights -->
      <div class="footer-col">
        <h3 class="footer-heading">Ethics & Governance</h3>
        <ul class="footer-links">
          <li><a href="/about">About the Journal</a></li>
          <li><a href="/about#rights-policy">Rights & Attribution Notice</a></li>
          <li><a href="/about#privacy-policy">Reader Privacy Policy</a></li>
          <li><a href="/community">Community & Collaboration (सहयोग)</a></li>
          <li><a href="/archive">Search Archives</a></li>
          <li><a href="#top" class="back-to-top">↑ Back to Top</a></li>
        </ul>
      </div>

      <!-- Col 4: Colophon -->
      <div class="footer-col col-colophon">
        <h3 class="footer-heading">Colophon</h3>
        <p class="colophon-text">
          Set in <em>Noto Serif Devanagari</em>, <em>Newsreader</em>, <em>Playfair Display</em>, and <em>Inter</em>. 
          Engineered with Astro & static architecture for zero tracker intrusion and sustainable reading performance.
        </p>
      </div>
    </div>

    <!-- Bottom Legal Notice & Rights Statement -->
    <div class="footer-bottom">
      <p class="rights-notice">
        © {PUBLICATION_INFO.foundedYear} {PUBLICATION_INFO.name}. {PUBLICATION_INFO.rightsNotice}
      </p>
      <p class="privacy-note">
        Zero analytics trackers • Private client-side reader settings • Built with Antigravity IDE
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--border-strong);
    background-color: var(--bg-surface);
    margin-top: auto;
    padding-block: var(--space-12) var(--space-8);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .footer-brand {
    font-family: var(--font-masthead);
    font-size: var(--text-xl);
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .footer-brand-hi {
    display: block;
    font-family: var(--font-display-hi);
    color: var(--accent-crimson);
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .footer-desc {
    font-family: var(--font-prose-en);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .footer-curator {
    color: var(--text-primary);
    font-size: var(--text-xs);
  }

  .footer-heading {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-1);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--accent-crimson);
  }

  .colophon-text {
    font-family: var(--font-prose-en);
    line-height: 1.6;
    font-style: italic;
    color: var(--text-muted);
  }

  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
