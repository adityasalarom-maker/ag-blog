---
import type { Work } from '../data/fixtures';

interface Props {
  work: Work;
  featured?: boolean;
}

const { work, featured = false } = Astro.props;

// Compute destination link based on content type
let href = `/poetry/${work.slug}`;
if (work.contentType === 'story' || work.contentType === 'essay') {
  href = `/prose/${work.slug}`;
} else if (work.contentType === 'artwork') {
  href = `/gallery#${work.slug}`;
} else if (work.contentType === 'thought' || work.contentType === 'quote') {
  href = `/thoughts#${work.slug}`;
}

const isHi = work.language === 'hi' && work.script === 'Deva';
---

<article class={`work-card ${featured ? 'card-featured' : ''} type-${work.contentType}`} id={`card-${work.slug}`}>
  {work.coverImage && (
    <div class="card-media">
      <img src={work.coverImage} alt={work.coverAlt || work.title} loading="lazy" class="card-img" />
      <span class="media-type-badge">{work.contentType}</span>
    </div>
  )}

  <div class="card-content">
    <div class="card-meta">
      <span class={`badge badge-${work.contentType}`}>
        {work.contentType === 'poem' ? 'Poetry / कविता' : 
         work.contentType === 'story' ? 'Story / कथा' : 
         work.contentType === 'essay' ? 'Essay / निबंध' : 
         work.contentType === 'thought' ? 'Thought / विचार' : 
         work.contentType === 'quote' ? 'Sourced Quote' : 'Artwork / कला'}
      </span>

      <span class="lang-tag">
        {work.language === 'hi' ? (work.script === 'Deva' ? 'हिंदी (देवनागरी)' : 'Romanized Hindi') : 'English'}
      </span>

      {work.readingTimeMinutes && (
        <span class="read-time">{work.readingTimeMinutes} min read</span>
      )}
    </div>

    <h3 class="card-title" lang={isHi ? 'hi' : 'en'}>
      <a href={href} class="title-link">{work.title}</a>
    </h3>

    <p class="card-excerpt" lang={isHi ? 'hi' : 'en'}>
      {work.excerpt}
    </p>

    <div class="card-footer">
      <div class="creator-info">
        <span class="creator-name">{work.creator}</span>
        <span class="rights-pill">{work.rights.status}</span>
      </div>
      <a href={href} class="read-more-link" aria-label={`Read ${work.title}`}>
        <span>Read Work</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .work-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .work-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--border-strong);
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 220px;
    background-color: var(--bg-subtle);
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .work-card:hover .card-img {
    transform: scale(1.03);
  }

  .media-type-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background-color: rgba(15, 16, 18, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .lang-tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 500;
  }

  .read-time {
    font-size: var(--text-xs);
    color: var(--accent-gold);
    font-weight: 600;
    margin-left: auto;
  }

  .card-title {
    font-family: var(--font-display-en);
    font-size: var(--text-xl);
    line-height: 1.3;
    margin-bottom: var(--space-2);
  }

  .card-title[lang="hi"] {
    font-family: var(--font-display-hi);
    line-height: 1.4;
    font-size: calc(var(--text-xl) * 1.05);
  }

  .title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .title-link:hover {
    color: var(--accent-crimson);
  }

  .card-excerpt {
    font-family: var(--font-prose-en);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex: 1;
  }

  .card-excerpt[lang="hi"] {
    font-family: var(--font-prose-hi);
    line-height: 1.8;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
  }

  .creator-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .creator-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .rights-pill {
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-crimson);
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .read-more-link:hover {
    gap: 8px;
  }

  /* Featured variant */
  .card-featured {
    border-color: var(--accent-gold);
  }
</style>
