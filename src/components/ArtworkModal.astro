---
// ArtworkModal.astro — Deep Zoom & Pan Lightbox Modal (Phase 5)
---
<dialog id="artwork-lightbox" class="artwork-modal" closedby="any" aria-labelledby="lightbox-title" aria-describedby="lightbox-caption">
  <div class="modal-wrapper">
    <!-- Header with Title, Zoom Controls and Close Button -->
    <header class="modal-header">
      <div class="modal-titles">
        <h3 id="lightbox-title" class="lightbox-title">Artwork Title</h3>
        <p id="lightbox-artist" class="lightbox-artist">Artist Attribution</p>
      </div>

      <div class="modal-actions">
        <!-- Deep Zoom Control Group -->
        <div class="zoom-controls" role="group" aria-label="Artwork zoom controls">
          <button type="button" id="lightbox-zoom-out-btn" class="modal-action-btn" title="Zoom Out (-)" aria-label="Zoom out">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>

          <span id="zoom-level-indicator" class="zoom-level-indicator" title="Current Zoom Scale">100%</span>

          <button type="button" id="lightbox-zoom-in-btn" class="modal-action-btn" title="Zoom In (+)" aria-label="Zoom in">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>

          <button type="button" id="lightbox-zoom-reset-btn" class="modal-action-btn" title="Reset Zoom (0)" aria-label="Reset zoom to 100%">
            1:1
          </button>
        </div>

        <!-- Fullscreen Toggle -->
        <button type="button" id="lightbox-fullscreen-btn" class="modal-action-btn" title="Toggle Fullscreen" aria-label="Toggle fullscreen view">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 3 21 3 21 9"></polyline>
            <polyline points="9 21 3 21 3 15"></polyline>
            <line x1="21" y1="3" x2="14" y2="10"></line>
            <line x1="3" y1="21" x2="10" y2="14"></line>
          </svg>
        </button>

        <!-- Close Dialog -->
        <button type="button" id="lightbox-close-btn" class="modal-action-btn close-btn" title="Close dialog (Esc)" aria-label="Close dialog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Image Display Container with Carousel Navigation -->
    <div class="image-viewport" id="image-viewport" tabindex="0" role="region" aria-label="Interactive artwork canvas. Use mouse drag or arrow keys to pan when zoomed.">
      <!-- Carousel Previous Button -->
      <button type="button" id="lightbox-prev-btn" class="carousel-nav-btn prev-btn" title="Previous Artwork (Left Arrow)" aria-label="Previous artwork">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Zoomable & Pannable Image Canvas -->
      <div class="image-stage" id="image-stage">
        <img id="lightbox-img" src="" alt="" class="modal-image" loading="lazy" draggable="false" />
      </div>

      <!-- Carousel Next Button -->
      <button type="button" id="lightbox-next-btn" class="carousel-nav-btn next-btn" title="Next Artwork (Right Arrow)" aria-label="Next artwork">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Pan Help Indicator -->
      <div class="pan-helper" id="pan-helper">
        <span>✦ Drag image to pan • Click image to zoom • Double-click to reset</span>
      </div>
    </div>

    <!-- Footer with Technical Artwork Details & Declared Rights -->
    <footer class="modal-footer">
      <div class="footer-meta-bar">
        <div class="meta-row">
          <span class="meta-item"><strong>Medium:</strong> <span id="lightbox-medium">—</span></span>
          <span class="meta-item"><strong>Dimensions:</strong> <span id="lightbox-dimensions">—</span></span>
          <span class="meta-item"><strong>Year:</strong> <span id="lightbox-year">—</span></span>
          <span class="meta-item carousel-counter" id="lightbox-counter">Artwork 1 of 1</span>
        </div>
        <div class="rights-badge" id="lightbox-rights">Declared Creator Original</div>
      </div>
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </footer>
  </div>
</dialog>

<style>
  .artwork-modal {
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    background: transparent;
    max-width: 95vw;
    max-height: 95vh;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    color: var(--text-primary);
    overflow: hidden;
  }

  .artwork-modal::backdrop {
    background-color: rgba(5, 7, 10, 0.88);
    backdrop-filter: blur(8px);
  }

  .modal-wrapper {
    display: flex;
    flex-direction: column;
    width: 92vw;
    max-width: 1280px;
    height: 88vh;
    max-height: 900px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
    flex-shrink: 0;
  }

  .lightbox-title {
    font-family: var(--font-masthead);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .lightbox-artist {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .modal-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .zoom-controls {
    display: inline-flex;
    align-items: center;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 2px;
  }

  .zoom-level-indicator {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    min-width: 44px;
    text-align: center;
    user-select: none;
  }

  .modal-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    padding: 5px 9px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .modal-action-btn:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-subtle);
    color: var(--accent-crimson);
  }

  .close-btn {
    padding: 6px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .close-btn:hover {
    background-color: var(--bg-subtle);
    color: var(--accent-crimson);
  }

  /* Viewport and Stage */
  .image-viewport {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #08090b;
    outline: none;
    user-select: none;
  }

  .image-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transform-origin: center center;
    transition: transform 0.1s ease-out;
  }

  .modal-image {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    cursor: zoom-in;
    transition: box-shadow 0.2s ease;
  }

  .modal-image.is-panning {
    cursor: grab;
  }

  .modal-image.is-dragging {
    cursor: grabbing;
  }

  /* Carousel Navigation Buttons */
  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(20, 22, 28, 0.75);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .carousel-nav-btn:hover {
    background: rgba(158, 42, 43, 0.9);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-50%) scale(1.08);
  }

  .prev-btn {
    left: var(--space-4);
  }

  .next-btn {
    right: var(--space-4);
  }

  .carousel-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  .pan-helper {
    position: absolute;
    bottom: var(--space-3);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 17, 22, 0.8);
    color: rgba(255, 255, 255, 0.7);
    padding: 3px 12px;
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    pointer-events: none;
    letter-spacing: 0.04em;
    backdrop-filter: blur(4px);
  }

  /* Footer */
  .modal-footer {
    padding: var(--space-3) var(--space-6);
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
    font-size: var(--text-xs);
    flex-shrink: 0;
  }

  .footer-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    color: var(--text-secondary);
  }

  .carousel-counter {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .lightbox-caption {
    font-family: var(--font-prose-en);
    font-style: italic;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .rights-badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    background-color: var(--badge-bg);
    color: var(--badge-text);
    font-weight: 600;
    font-size: 0.7rem;
  }

  @media (max-width: 640px) {
    .modal-wrapper {
      width: 98vw;
      height: 94vh;
    }
    .zoom-level-indicator, .pan-helper {
      display: none;
    }
    .carousel-nav-btn {
      width: 36px;
      height: 36px;
    }
    .prev-btn {
      left: var(--space-2);
    }
    .next-btn {
      right: var(--space-2);
    }
  }
</style>

<script>
  function setupLightbox() {
    const dialog = document.getElementById('artwork-lightbox') as HTMLDialogElement | null;
    if (!dialog) return;

    const closeBtn = document.getElementById('lightbox-close-btn');
    const zoomInBtn = document.getElementById('lightbox-zoom-in-btn');
    const zoomOutBtn = document.getElementById('lightbox-zoom-out-btn');
    const zoomResetBtn = document.getElementById('lightbox-zoom-reset-btn');
    const zoomIndicator = document.getElementById('zoom-level-indicator');
    const fullscreenBtn = document.getElementById('lightbox-fullscreen-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('lightbox-next-btn') as HTMLButtonElement | null;
    const counterEl = document.getElementById('lightbox-counter');

    const viewport = document.getElementById('image-viewport');
    const stage = document.getElementById('image-stage');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const titleEl = document.getElementById('lightbox-title');
    const artistEl = document.getElementById('lightbox-artist');
    const mediumEl = document.getElementById('lightbox-medium');
    const dimensionsEl = document.getElementById('lightbox-dimensions');
    const yearEl = document.getElementById('lightbox-year');
    const captionEl = document.getElementById('lightbox-caption');
    const rightsEl = document.getElementById('lightbox-rights');

    // Deep Zoom & Pan State
    let zoomScale = 1;
    const MIN_ZOOM = 0.8;
    const MAX_ZOOM = 3.5;
    const ZOOM_STEP = 0.35;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    // Carousel State
    let currentTriggerIndex = -1;
    let activeTriggers: HTMLElement[] = [];

    function updateTransform() {
      if (!stage || !img) return;
      stage.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomScale})`;
      if (zoomIndicator) {
        zoomIndicator.textContent = `${Math.round(zoomScale * 100)}%`;
      }

      if (zoomScale > 1) {
        img.classList.add('is-panning');
      } else {
        img.classList.remove('is-panning');
      }
    }

    function setZoom(newScale: number) {
      zoomScale = Math.min(Math.max(newScale, MIN_ZOOM), MAX_ZOOM);
      if (zoomScale <= 1) {
        panX = 0;
        panY = 0;
      }
      updateTransform();
    }

    function resetZoom() {
      zoomScale = 1;
      panX = 0;
      panY = 0;
      updateTransform();
    }

    // Zoom Buttons
    zoomInBtn?.addEventListener('click', () => setZoom(zoomScale + ZOOM_STEP));
    zoomOutBtn?.addEventListener('click', () => setZoom(zoomScale - ZOOM_STEP));
    zoomResetBtn?.addEventListener('click', resetZoom);

    // Fullscreen Toggle
    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        dialog.requestFullscreen?.().catch(() => {});
      } else {
        document.exitFullscreen?.().catch(() => {});
      }
    });

    // Close Dialog
    closeBtn?.addEventListener('click', () => {
      resetZoom();
      dialog.close();
    });

    // Click on image to toggle zoom
    img?.addEventListener('click', () => {
      if (isDragging) return;
      if (zoomScale === 1) {
        setZoom(1.8);
      } else {
        resetZoom();
      }
    });

    // Mouse / Touch Drag Panning
    viewport?.addEventListener('mousedown', (e) => {
      if (zoomScale <= 1 || e.button !== 0) return;
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      img?.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      updateTransform();
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        img?.classList.remove('is-dragging');
      }
    });

    // Mouse Wheel Zoom
    viewport?.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP;
      setZoom(zoomScale + delta);
    }, { passive: false });

    // Touch Drag Panning
    let touchStartX = 0;
    let touchStartY = 0;
    viewport?.addEventListener('touchstart', (e) => {
      if (zoomScale <= 1 || e.touches.length !== 1) return;
      touchStartX = e.touches[0].clientX - panX;
      touchStartY = e.touches[0].clientY - panY;
    }, { passive: true });

    viewport?.addEventListener('touchmove', (e) => {
      if (zoomScale <= 1 || e.touches.length !== 1) return;
      panX = e.touches[0].clientX - touchStartX;
      panY = e.touches[0].clientY - touchStartY;
      updateTransform();
    }, { passive: true });

    // Display Artwork by Trigger Index
    function loadArtwork(index: number) {
      if (index < 0 || index >= activeTriggers.length) return;
      currentTriggerIndex = index;
      const trigger = activeTriggers[index];

      const src = trigger.getAttribute('data-img-src') || '';
      const title = trigger.getAttribute('data-title') || '';
      const artist = trigger.getAttribute('data-artist') || '';
      const medium = trigger.getAttribute('data-medium') || '';
      const dimensions = trigger.getAttribute('data-dimensions') || '';
      const year = trigger.getAttribute('data-year') || '';
      const caption = trigger.getAttribute('data-caption') || '';
      const rights = trigger.getAttribute('data-rights') || '';

      if (img) {
        img.src = src;
        img.alt = title;
      }
      if (titleEl) titleEl.textContent = title;
      if (artistEl) artistEl.textContent = artist;
      if (mediumEl) mediumEl.textContent = medium || 'Original Work';
      if (dimensionsEl) dimensionsEl.textContent = dimensions || 'Original Resolution';
      if (yearEl) yearEl.textContent = year || '2026';
      if (captionEl) captionEl.textContent = caption;
      if (rightsEl) rightsEl.textContent = rights || 'Declared Creator Original';

      if (counterEl) {
        counterEl.textContent = `Artwork ${index + 1} of ${activeTriggers.length}`;
      }

      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === activeTriggers.length - 1;

      resetZoom();
    }

    prevBtn?.addEventListener('click', () => {
      if (currentTriggerIndex > 0) loadArtwork(currentTriggerIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      if (currentTriggerIndex < activeTriggers.length - 1) loadArtwork(currentTriggerIndex + 1);
    });

    // Keyboard Shortcuts inside modal
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        if (currentTriggerIndex < activeTriggers.length - 1) loadArtwork(currentTriggerIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        if (currentTriggerIndex > 0) loadArtwork(currentTriggerIndex - 1);
      } else if (e.key === '+' || e.key === '=') {
        setZoom(zoomScale + ZOOM_STEP);
      } else if (e.key === '-' || e.key === '_') {
        setZoom(zoomScale - ZOOM_STEP);
      } else if (e.key === '0') {
        resetZoom();
      }
    });

    // Backdrop dismissal fallback
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isDialogContent) {
          resetZoom();
          dialog.close();
        }
      });
    }

    // Bind all [data-artwork-trigger] elements on the current page
    activeTriggers = Array.from(document.querySelectorAll<HTMLElement>('[data-artwork-trigger]'));
    activeTriggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        loadArtwork(index);
        dialog.showModal();
      });
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
