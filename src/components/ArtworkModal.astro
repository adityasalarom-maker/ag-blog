---
// ArtworkModal.astro — Accessible Lightbox modal adhering to modern-web-guidance
---
<dialog id="artwork-lightbox" class="artwork-modal" closedby="any" aria-labelledby="lightbox-title" aria-describedby="lightbox-caption">
  <div class="modal-wrapper">
    <!-- Header with Title and Close Button -->
    <header class="modal-header">
      <div class="modal-titles">
        <h3 id="lightbox-title" class="lightbox-title">Artwork Title</h3>
        <p id="lightbox-artist" class="lightbox-artist">Artist Attribution</p>
      </div>
      <div class="modal-actions">
        <button type="button" id="lightbox-zoom-btn" class="modal-action-btn" title="Toggle Zoom Level" aria-label="Toggle image zoom">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span id="zoom-text">Zoom</span>
        </button>

        <button type="button" id="lightbox-close-btn" class="modal-action-btn close-btn" title="Close dialog (Esc)" aria-label="Close dialog">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Image Display Container -->
    <div class="image-viewport" id="image-viewport">
      <img id="lightbox-img" src="" alt="" class="modal-image" loading="lazy" />
    </div>

    <!-- Footer with Technical Artwork Details & Declared Rights -->
    <footer class="modal-footer">
      <div class="meta-row">
        <span class="meta-item"><strong>Medium:</strong> <span id="lightbox-medium">—</span></span>
        <span class="meta-item"><strong>Dimensions:</strong> <span id="lightbox-dimensions">—</span></span>
        <span class="meta-item"><strong>Year:</strong> <span id="lightbox-year">—</span></span>
      </div>
      <p id="lightbox-caption" class="lightbox-caption"></p>
      <div class="rights-badge" id="lightbox-rights">Declared Creator Original</div>
    </footer>
  </div>
</dialog>

<style>
  .modal-wrapper {
    display: flex;
    flex-direction: column;
    max-width: 90vw;
    max-height: 90vh;
    background-color: var(--bg-surface);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
  }

  .lightbox-title {
    font-family: var(--font-display-en);
    font-size: var(--text-lg);
    margin: 0;
  }

  .lightbox-artist {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .modal-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .modal-action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    font-size: var(--text-xs);
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .modal-action-btn:hover {
    background-color: var(--bg-subtle);
    border-color: var(--border-strong);
  }

  .close-btn {
    padding: 6px;
    border-color: transparent;
  }

  .close-btn:hover {
    color: var(--accent-crimson);
  }

  .image-viewport {
    flex: 1;
    overflow: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    background-color: #0b0c0e;
    min-height: 40vh;
    max-height: 65vh;
  }

  .modal-image {
    max-width: 100%;
    max-height: 60vh;
    object-fit: contain;
    transition: transform 0.25s ease;
    cursor: zoom-in;
    border-radius: var(--radius-sm);
  }

  .modal-image.is-zoomed {
    max-width: none;
    max-height: none;
    transform: scale(1.65);
    cursor: zoom-out;
    margin: 20%;
  }

  .modal-footer {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-page);
    font-size: var(--text-xs);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
  }

  .lightbox-caption {
    font-family: var(--font-prose-en);
    font-style: italic;
    color: var(--text-primary);
    line-height: 1.5;
    margin-bottom: var(--space-2);
  }

  .rights-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background-color: var(--badge-bg);
    color: var(--badge-text);
    font-weight: 600;
    font-size: 0.7rem;
  }
</style>

<script>
  function setupLightbox() {
    const dialog = document.getElementById('artwork-lightbox') as HTMLDialogElement | null;
    if (!dialog) return;

    const closeBtn = document.getElementById('lightbox-close-btn');
    const zoomBtn = document.getElementById('lightbox-zoom-btn');
    const zoomText = document.getElementById('zoom-text');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const titleEl = document.getElementById('lightbox-title');
    const artistEl = document.getElementById('lightbox-artist');
    const mediumEl = document.getElementById('lightbox-medium');
    const dimensionsEl = document.getElementById('lightbox-dimensions');
    const yearEl = document.getElementById('lightbox-year');
    const captionEl = document.getElementById('lightbox-caption');
    const rightsEl = document.getElementById('lightbox-rights');

    // Close button event
    closeBtn?.addEventListener('click', () => dialog.close());

    // Zoom toggle
    function toggleZoom() {
      if (!img) return;
      const isZoomed = img.classList.toggle('is-zoomed');
      if (zoomText) zoomText.textContent = isZoomed ? 'Reset Zoom' : 'Zoom';
    }

    zoomBtn?.addEventListener('click', toggleZoom);
    img?.addEventListener('click', toggleZoom);

    // Modern-web-guidance fallback for browsers without native <dialog closedby>
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isDialogContent) dialog.close();
      });
    }

    // Attach trigger listener to all elements with [data-artwork-trigger]
    document.querySelectorAll<HTMLElement>('[data-artwork-trigger]').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-img-src') || '';
        const title = trigger.getAttribute('data-title') || '';
        const artist = trigger.getAttribute('data-artist') || '';
        const medium = trigger.getAttribute('data-medium') || '';
        const dimensions = trigger.getAttribute('data-dimensions') || '';
        const year = trigger.getAttribute('data-year') || '';
        const caption = trigger.getAttribute('data-caption') || '';
        const rights = trigger.getAttribute('data-rights') || '';

        if (img) {
          img.src = src;
          img.alt = title;
          img.classList.remove('is-zoomed');
        }
        if (zoomText) zoomText.textContent = 'Zoom';
        if (titleEl) titleEl.textContent = title;
        if (artistEl) artistEl.textContent = artist;
        if (mediumEl) mediumEl.textContent = medium;
        if (dimensionsEl) dimensionsEl.textContent = dimensions;
        if (yearEl) yearEl.textContent = year;
        if (captionEl) captionEl.textContent = caption;
        if (rightsEl) rightsEl.textContent = rights;

        dialog.showModal();
      });
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
