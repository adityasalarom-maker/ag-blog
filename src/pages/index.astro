---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { WORKS, COLLECTIONS, PUBLICATION_INFO } from '../data/fixtures';

// Select featured works
const heroPoem = WORKS.find(w => w.slug === 'smritiyon-ki-dehari-par')!;
const leadStory = WORKS.find(w => w.slug === 'the-keeper-of-forgotten-manuscripts')!;
const featuredArtworks = WORKS.filter(w => w.contentType === 'artwork');
const recentWorks = WORKS.filter(w => w.slug !== heroPoem.slug && w.slug !== leadStory.slug).slice(0, 4);
const featuredThought = WORKS.find(w => w.slug === 'maun-ka-arth')!;
const featuredQuote = WORKS.find(w => w.slug === 'mirza-ghalib-na-tha-kuch-to-khuda-tha')!;
---

<BaseLayout 
  title="Antigravity Review — A Creator-Led Bilingual Journal"
  description="A publication dedicated to contemplative reading, bilingual poetry in Hindi and English, long-form essays, and fine visual artworks."
>
  <!-- Hero Section: Editorial Lead Feature -->
  <section class="hero-section" aria-labelledby="hero-heading">
    <div class="container hero-container">
      <div class="hero-grid">
        <!-- Lead Feature Card -->
        <article class="hero-lead">
          <div class="lead-badge-row">
            <span class="badge badge-poetry">Featured Poetry • मुख्य रचना</span>
            <span class="edition-pill">हिंदी (देवनागरी)</span>
          </div>

          <h2 id="hero-heading" class="lead-title" lang="hi">
            <a href={`/poetry/${heroPoem.slug}`}>{heroPoem.title}</a>
          </h2>

          <div class="lead-verse-preview" lang="hi">
            <p>धुंधले आकाश की छांव तले,</p>
            <p>जलते हुए दीये की कांपती लौ में,</p>
            <p>समय ने अपनी परछाईं को</p>
            <p>चुपचाप जल की सतह पर समेट लिया...</p>
          </div>

          <div class="lead-author-row">
            <span class="author-label">रचनाकार:</span>
            <strong class="author-name">{heroPoem.creator}</strong>
            <span class="rights-marker">✦ मौलिक रचना</span>
          </div>

          <div class="lead-cta-row">
            <a href={`/poetry/${heroPoem.slug}`} class="btn btn-primary">
              सम्पूर्ण कविता पढ़ें (Read Full Poem)
            </a>
            <a href="/poetry" class="btn btn-outline">
              कविता संग्रह (Poetry Archive) →
            </a>
          </div>
        </article>

        <!-- Companion Lead Artwork Feature -->
        <div class="hero-artwork-card">
          <div class="hero-art-media">
            <img 
              src={heroPoem.coverImage} 
              alt={heroPoem.coverAlt} 
              class="hero-art-img" 
              loading="eager" 
              data-artwork-trigger
              data-img-src={heroPoem.coverImage}
              data-title="सांझ का मौन (Monsoon Twilight)"
              data-artist={heroPoem.creator}
              data-medium="Watercolor & Gouache on Cold-Press Paper"
              data-dimensions="56 × 32 cm"
              data-year="2026"
              data-caption="A visual companion piece evoking the stillness of the monsoon riverbank at twilight."
              data-rights="Creator-Declared Original Artwork"
            />
            <button 
              type="button" 
              class="art-inspect-overlay"
              data-artwork-trigger
              data-img-src={heroPoem.coverImage}
              data-title="सांझ का मौन (Monsoon Twilight)"
              data-artist={heroPoem.creator}
              data-medium="Watercolor & Gouache on Cold-Press Paper"
              data-dimensions="56 × 32 cm"
              data-year="2026"
              data-caption="A visual companion piece evoking the stillness of the monsoon riverbank at twilight."
              data-rights="Creator-Declared Original Artwork"
              aria-label="Enlarge and zoom artwork"
            >
              <span>🔍 Tap to Zoom Artwork</span>
            </button>
          </div>
          <div class="hero-art-caption">
            <span class="caption-title">सांझ का मौन • Monsoon Twilight (2026)</span>
            <span class="caption-medium">Watercolor on Cotton Rag • A. G. Varma</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Curated Collection Spotlight -->
  <section class="section-collections" aria-labelledby="collections-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Curated Anthologies • सम्पादकीय चयन</span>
          <h2 id="collections-heading" class="section-title">Thematic Collections</h2>
        </div>
        <a href="/collections" class="section-more-link">View All Collections →</a>
      </div>

      <div class="collections-grid">
        {COLLECTIONS.map(col => (
          <article class="collection-feature-card">
            <div class="collection-cover">
              <img src={col.coverImage} alt={col.title} loading="lazy" />
              <div class="collection-overlay">
                <span class="collection-badge">{col.itemSlugs.length} Works Interlinked</span>
              </div>
            </div>
            <div class="collection-body">
              <h3 class="collection-card-title">
                <a href={`/collections/${col.slug}`}>{col.title}</a>
              </h3>
              {col.titleHi && <span class="collection-card-hi">{col.titleHi}</span>}
              <p class="collection-desc">{col.description}</p>
              <a href={`/collections/${col.slug}`} class="collection-cta">Explore Anthology →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Split Literary Showcase: Fiction, Reflection & Bilingual Pairs -->
  <section class="section-literature" aria-labelledby="literature-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Writings & Explorations • साहित्य व विमर्श</span>
          <h2 id="literature-heading" class="section-title">Recent Works</h2>
        </div>
        <a href="/archive" class="section-more-link">Complete Catalog →</a>
      </div>

      <div class="works-grid">
        {recentWorks.map(work => (
          <WorkCard work={work} />
        ))}
      </div>
    </div>
  </section>

  <!-- Thoughts & Quotations Feature -->
  <section class="section-thoughts" aria-labelledby="thoughts-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Contemplative Aphorisms • विचार व सूक्तियां</span>
          <h2 id="thoughts-heading" class="section-title">Thoughts & Attributed Citations</h2>
        </div>
        <a href="/thoughts" class="section-more-link">View All Thoughts →</a>
      </div>

      <div class="thoughts-dual-grid">
        <!-- Original Creator Thought -->
        <div class="thought-card" id={`thought-${featuredThought.slug}`}>
          <div class="thought-badge-row">
            <span class="badge badge-thought">Original Thought • मौलिक विचार</span>
            <span class="creator-tag">{featuredThought.creator}</span>
          </div>
          <blockquote class="thought-quote" lang="hi">
            "{featuredThought.body}"
          </blockquote>
          <footer class="thought-footer">
            <span class="rights-note">{featuredThought.rights.notice}</span>
            <a href={`/thoughts#${featuredThought.slug}`} class="thought-link">Permalink ↗</a>
          </footer>
        </div>

        <!-- Attributed Source Quotation -->
        <div class="quote-card" id={`quote-${featuredQuote.slug}`}>
          <div class="quote-badge-row">
            <span class="badge badge-quote">Attributed Citation • ऐतिहासिक उद्धरण</span>
            <span class="source-verified-badge">✓ Verified Source</span>
          </div>
          <blockquote class="quote-verse" lang="hi">
            "{featuredQuote.body}"
          </blockquote>
          <footer class="quote-footer">
            <div class="quote-source-details">
              <strong>{featuredQuote.quoteSource?.author}</strong>
              <span>— {featuredQuote.quoteSource?.workTitle} ({featuredQuote.quoteSource?.year})</span>
            </div>
            {featuredQuote.quoteSource?.url && (
              <a href={featuredQuote.quoteSource.url} target="_blank" rel="noopener noreferrer" class="source-link">
                Source Reference ↗
              </a>
            )}
          </footer>
        </div>
      </div>
    </div>
  </section>

  <!-- Visual Art Gallery Preview -->
  <section class="section-gallery" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-kicker">Fine Art & Craft • दृश्य कला वीथिका</span>
          <h2 id="gallery-heading" class="section-title">Gallery Highlights</h2>
        </div>
        <a href="/gallery" class="section-more-link">Enter Gallery →</a>
      </div>

      <div class="art-gallery-preview-grid">
        {featuredArtworks.map(art => (
          <div class="gallery-item-card">
            <div class="art-thumbnail-wrap">
              <img 
                src={art.coverImage} 
                alt={art.coverAlt} 
                class="art-thumb-img" 
                loading="lazy" 
                data-artwork-trigger
                data-img-src={art.coverImage}
                data-title={art.title}
                data-artist={art.creator}
                data-medium={art.artworkDetails?.medium || ''}
                data-dimensions={art.artworkDetails?.dimensions || ''}
                data-year={art.artworkDetails?.yearCreated?.toString() || ''}
                data-caption={art.excerpt}
                data-rights={art.rights.notice}
              />
              <button 
                type="button" 
                class="thumb-zoom-btn"
                data-artwork-trigger
                data-img-src={art.coverImage}
                data-title={art.title}
                data-artist={art.creator}
                data-medium={art.artworkDetails?.medium || ''}
                data-dimensions={art.artworkDetails?.dimensions || ''}
                data-year={art.artworkDetails?.yearCreated?.toString() || ''}
                data-caption={art.excerpt}
                data-rights={art.rights.notice}
                aria-label={`Zoom artwork ${art.title}`}
              >
                🔍 Zoom Artwork
              </button>
            </div>
            <div class="art-card-details">
              <h3 class="art-title">{art.title}</h3>
              <p class="art-meta">{art.artworkDetails?.medium} • {art.artworkDetails?.yearCreated}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding-block: var(--space-8) var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lead-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .edition-pill {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 500;
  }

  .lead-title {
    font-family: var(--font-display-hi);
    font-size: clamp(2.2rem, 4.5vw, 3.25rem);
    line-height: 1.25;
  }

  .lead-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lead-title a:hover {
    color: var(--accent-crimson);
  }

  .lead-verse-preview {
    font-family: var(--font-prose-hi);
    font-size: var(--text-lg);
    line-height: 1.9;
    color: var(--text-secondary);
    border-left: 3px solid var(--accent-crimson);
    padding-left: var(--space-4);
    font-style: italic;
  }

  .lead-verse-preview p {
    margin-bottom: var(--space-1);
  }

  .lead-author-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .rights-marker {
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-left: var(--space-2);
  }

  .lead-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Hero Artwork */
  .hero-artwork-card {
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .hero-art-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0b0c0e;
  }

  .hero-art-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .hero-art-media:hover .hero-art-img {
    transform: scale(1.02);
  }

  .art-inspect-overlay {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    background-color: rgba(15, 16, 18, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .art-inspect-overlay:hover {
    background-color: var(--accent-crimson);
  }

  .hero-art-caption {
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
    background-color: var(--bg-surface);
  }

  .caption-title {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .caption-medium {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Section Common Styling */
  .section-collections, .section-literature, .section-thoughts, .section-gallery {
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-8);
  }

  .section-kicker {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-crimson);
    margin-bottom: var(--space-1);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .section-more-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-crimson);
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .section-more-link:hover {
    text-decoration: underline;
  }

  /* Collections Grid */
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .collection-feature-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .collection-feature-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .collection-cover {
    position: relative;
    height: 180px;
  }

  .collection-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-overlay {
    position: absolute;
    bottom: var(--space-2);
    left: var(--space-2);
  }

  .collection-badge {
    background: rgba(15, 16, 18, 0.8);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .collection-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .collection-card-title {
    font-family: var(--font-display-en);
    font-size: var(--text-lg);
    margin-bottom: 2px;
  }

  .collection-card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .collection-card-hi {
    font-family: var(--font-display-hi);
    color: var(--accent-crimson);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .collection-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .collection-cta {
    color: var(--accent-crimson);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  /* Works Grid */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  /* Thoughts Dual Grid */
  .thoughts-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .thought-badge-row, .quote-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .creator-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
  }

  .source-verified-badge {
    font-size: var(--text-xs);
    color: #2b8a3e;
    font-weight: 600;
  }

  .thought-quote, .quote-verse {
    font-family: var(--font-quote);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .thought-footer, .quote-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }

  .rights-note {
    color: var(--text-muted);
  }

  .thought-link, .source-link {
    color: var(--accent-crimson);
    text-decoration: none;
    font-weight: 600;
  }

  /* Art Gallery Preview Grid */
  .art-gallery-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .gallery-item-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
  }

  .art-thumbnail-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #0b0c0e;
  }

  .art-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .gallery-item-card:hover .art-thumb-img {
    transform: scale(1.03);
  }

  .thumb-zoom-btn {
    position: absolute;
    bottom: var(--space-2);
    right: var(--space-2);
    background-color: rgba(15, 16, 18, 0.8);
    backdrop-filter: blur(4px);
    color: #fff;
    border: none;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .art-card-details {
    padding: var(--space-4);
  }

  .art-title {
    font-size: var(--text-base);
    margin-bottom: 2px;
  }

  .art-meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .thoughts-dual-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
