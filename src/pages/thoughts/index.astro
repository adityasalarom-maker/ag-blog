---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import { WORKS } from '../../data/fixtures';

const thoughts = WORKS.filter(w => w.contentType === 'thought');
const quotes = WORKS.filter(w => w.contentType === 'quote');
const allItems = [...thoughts, ...quotes];
---

<BaseLayout 
  title="Thoughts & Attributed Quotations (विचार व सूक्तियां) — Antigravity Review"
  description="A curated repository of original philosophical aphorisms and verified literary quotations, strictly separating creator thoughts from classical attributions."
>
  <div class="container page-container">
    <header class="page-header">
      <span class="badge badge-prose">Epigrams & Citations • विचार और उद्धरण</span>
      <h1 class="page-title">Thoughts & Quotations</h1>
      <p class="page-subtitle">
        Philosophical aphorisms and literary citations. In accordance with our publication ethics, original creator reflections are strictly distinguished from attributed historical quotations.
      </p>

      <!-- Filter Controls -->
      <div class="filter-bar" role="toolbar" aria-label="Filter thoughts and quotations">
        <button type="button" class="filter-btn active" data-thought-filter="all">All Items ({allItems.length})</button>
        <button type="button" class="filter-btn" data-thought-filter="thought">Original Thoughts / मौलिक विचार ({thoughts.length})</button>
        <button type="button" class="filter-btn" data-thought-filter="quote">Sourced Quotations / उद्धरण ({quotes.length})</button>
      </div>
    </header>

    <div class="items-grid" id="thoughts-container">
      {allItems.map(item => {
        const isThought = item.contentType === 'thought';
        const isHi = item.language === 'hi' && item.script === 'Deva';

        return (
          <article 
            class={`item-card ${isThought ? 'card-thought' : 'card-quote'}`} 
            id={item.slug}
            data-category={item.contentType}
          >
            <!-- Card Header: Distinction Badge -->
            <div class="item-header">
              <span class={`badge ${isThought ? 'badge-thought-type' : 'badge-quote-type'}`}>
                {isThought ? '✦ Original Thought • मौलिक विचार' : '“ Attributed Citation • उद्धरण'}
              </span>

              <span class="script-indicator">
                {isHi ? 'हिंदी (देवनागरी)' : item.script === 'Latn' && item.language === 'hi' ? 'Romanized Hindi' : 'English'}
              </span>
            </div>

            <!-- Body / Verse Content -->
            <blockquote class="item-content" lang={isHi ? 'hi' : 'en'}>
              “{item.body}”
            </blockquote>

            <!-- Footer: Attribution or Provenance Details -->
            <footer class="item-footer">
              {isThought ? (
                <div class="creator-meta">
                  <span class="creator-name">By {item.creator}</span>
                  <span class="rights-note">{item.rights.notice}</span>
                </div>
              ) : (
                <div class="quote-source-block">
                  <div class="source-author-row">
                    <strong class="source-author">{item.quoteSource?.author}</strong>
                    {item.quoteSource?.isVerified && (
                      <span class="verified-pill" title="Source historically verified">✓ Verified Source</span>
                    )}
                  </div>
                  <p class="source-work">
                    {item.quoteSource?.workTitle} {item.quoteSource?.year && `(${item.quoteSource.year})`}
                  </p>
                  {item.quoteSource?.url && (
                    <a href={item.quoteSource.url} target="_blank" rel="noopener noreferrer" class="source-external-link">
                      Examine Original Source ↗
                    </a>
                  )}
                  <span class="rights-note">{item.rights.notice}</span>
                </div>
              )}

              <div class="item-share-row">
                <ShareButton title={`"${item.body}" — ${item.creator}`} url={`/thoughts#${item.slug}`} />
              </div>
            </footer>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding-top: var(--space-8);
  }

  .page-header {
    margin-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-family: var(--font-prose-en);
    font-size: var(--text-base);
    color: var(--text-secondary);
    max-width: 700px;
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 6px 16px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .filter-btn.active {
    background-color: var(--text-primary);
    color: var(--bg-page);
    border-color: var(--text-primary);
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-6);
  }

  .item-card {
    background-color: var(--bg-surface);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    border: 1px solid var(--border-subtle);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .item-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .card-thought {
    border-left: 5px solid var(--accent-gold);
  }

  .card-quote {
    border-left: 5px solid var(--accent-indigo);
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .badge-thought-type {
    background-color: rgba(194, 136, 63, 0.12);
    color: var(--accent-gold);
    border-color: rgba(194, 136, 63, 0.25);
  }

  .badge-quote-type {
    background-color: rgba(44, 66, 81, 0.12);
    color: var(--accent-indigo);
    border-color: rgba(44, 66, 81, 0.25);
  }

  .script-indicator {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .item-content {
    font-family: var(--font-quote);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
    flex: 1;
    font-style: italic;
  }

  .item-content[lang="hi"] {
    font-family: var(--font-prose-hi);
    line-height: 1.9;
    font-style: normal;
  }

  .item-footer {
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .creator-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .creator-name {
    font-weight: 700;
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .quote-source-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
  }

  .source-author-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .source-author {
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .verified-pill {
    background-color: rgba(43, 138, 62, 0.1);
    color: #2b8a3e;
    padding: 2px 6px;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.65rem;
  }

  .source-work {
    color: var(--text-secondary);
    font-style: italic;
  }

  .source-external-link {
    color: var(--accent-crimson);
    font-weight: 600;
    text-decoration: none;
    margin-top: 2px;
  }

  .source-external-link:hover {
    text-decoration: underline;
  }

  .rights-note {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: var(--space-1);
  }

  .item-share-row {
    margin-top: var(--space-2);
  }
</style>

<script>
  function setupThoughtFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-thought-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.item-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-thought-filter');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupThoughtFilters();
  document.addEventListener('astro:page-load', setupThoughtFilters);
</script>
