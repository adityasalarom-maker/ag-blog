---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { COLLECTIONS, WORKS, type Collection } from '../../data/fixtures';

export function getStaticPaths() {
  return COLLECTIONS.map(collection => ({
    params: { slug: collection.slug },
    props: { collection }
  }));
}

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const worksInCollection = WORKS.filter(w => collection.itemSlugs.includes(w.slug));
---

<BaseLayout 
  title={`${collection.title} — Curated Anthology | Antigravity Review`}
  description={collection.description}
  image={collection.coverImage}
>
  <div class="container collection-page-container">
    <nav class="breadcrumb" aria-label="Breadcrumb navigation">
      <a href="/">Front Page</a>
      <span class="sep">/</span>
      <a href="/collections">Collections</a>
      <span class="sep">/</span>
      <span class="current" aria-current="page">{collection.title}</span>
    </nav>

    <!-- Collection Hero Banner -->
    <header class="collection-hero">
      <div class="collection-hero-media">
        <img src={collection.coverImage} alt={collection.title} class="collection-hero-img" />
      </div>

      <div class="collection-hero-content">
        <span class="badge badge-poetry">Anthology • {worksInCollection.length} Works Interlinked</span>
        <h1 class="collection-heading">{collection.title}</h1>
        {collection.titleHi && <span class="collection-heading-hi">{collection.titleHi}</span>}
        
        <p class="collection-intro">{collection.description}</p>

        <div class="curator-statement">
          <h2 class="statement-label">Curator's Statement</h2>
          <p class="statement-body">"{collection.curatorNote}"</p>
        </div>
      </div>
    </header>

    <!-- Works Grid in this Collection -->
    <section class="collection-works-section" aria-labelledby="curated-contents-heading">
      <h2 id="curated-contents-heading" class="contents-title">Curated Contents in this Anthology</h2>
      
      <div class="works-grid">
        {worksInCollection.map(work => (
          <WorkCard work={work} />
        ))}
      </div>
    </section>

    <div class="collection-nav-bottom">
      <a href="/collections" class="btn btn-outline">← All Collections</a>
      <a href="/archive" class="btn btn-outline">Full Library Archive →</a>
    </div>
  </div>
</BaseLayout>

<style>
  .collection-page-container {
    padding-top: var(--space-6);
  }

  .breadcrumb {
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent-crimson);
  }

  .sep {
    color: var(--border-strong);
  }

  .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .collection-hero {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-8);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-16);
    box-shadow: var(--shadow-card);
  }

  .collection-hero-media {
    background-color: #0b0c0e;
    overflow: hidden;
  }

  .collection-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-hero-content {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .collection-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin: 0;
  }

  .collection-heading-hi {
    font-family: var(--font-display-hi);
    font-size: var(--text-lg);
    color: var(--accent-crimson);
    margin-top: -4px;
    margin-bottom: var(--space-2);
  }

  .collection-intro {
    font-family: var(--font-prose-en);
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .curator-statement {
    background-color: var(--bg-subtle);
    border-left: 3px solid var(--accent-gold);
    padding: var(--space-4);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-top: auto;
  }

  .statement-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-gold);
    margin-bottom: var(--space-1);
  }

  .statement-body {
    font-family: var(--font-prose-en);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--text-primary);
    line-height: 1.5;
  }

  .collection-works-section {
    margin-bottom: var(--space-16);
  }

  .contents-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-4);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .collection-nav-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-6);
  }

  @media (max-width: 860px) {
    .collection-hero {
      grid-template-columns: 1fr;
    }
    .collection-hero-media {
      height: 240px;
    }
  }
</style>
