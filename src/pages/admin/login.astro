---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { verifyAdminAuth } from '../../lib/auth/adminAuth.ts';

export const prerender = false;

// If already authenticated, redirect straight to admin dashboard
const auth = verifyAdminAuth(Astro.request);
if (auth.authorized) {
  return Astro.redirect('/admin');
}
---

<BaseLayout 
  title="Editorial Login — Antigravity Review"
  description="Restricted editorial entrance for Antigravity Review publication owner."
>
  <main class="login-wrapper">
    <div class="login-container">
      <div class="login-header">
        <span class="portal-badge">Editorial Sanctuary</span>
        <h1 class="portal-title">Antigravity Review</h1>
        <p class="portal-subtitle">संपादकीय एवं प्रकाशन कक्ष • Publishing Suite</p>
      </div>

      <div class="login-card">
        <form id="loginForm" class="login-form">
          <div class="field-group">
            <label for="adminPassword" class="field-label">Owner Access Passphrase</label>
            <input 
              type="password" 
              id="adminPassword" 
              name="password" 
              class="input-field" 
              placeholder="Enter owner passphrase..." 
              required 
              autofocus
            />
            <span class="field-hint">Private authentication token or publication passphrase.</span>
          </div>

          <div id="errorMessage" class="error-banner" style="display: none;" role="alert"></div>

          <button type="submit" id="submitBtn" class="btn-primary">
            <span>Unlock Editorial Suite</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>

        <div class="security-notice">
          <div class="notice-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <p>
            <strong>Private Editorial Boundary:</strong> Public registration is strictly disabled.
            Unauthorized access attempts are blocked server-side.
          </p>
        </div>
      </div>
    </div>
  </main>

  <style>
    .login-wrapper {
      min-height: calc(100vh - 200px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-8) var(--space-4);
    }

    .login-container {
      width: 100%;
      max-width: 460px;
    }

    .login-header {
      text-align: center;
      margin-bottom: var(--space-6);
    }

    .portal-badge {
      display: inline-block;
      font-family: var(--font-cinzel);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-gold);
      border: 1px solid var(--color-gold);
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      margin-bottom: var(--space-3);
    }

    .portal-title {
      font-family: var(--font-cinzel);
      font-size: 1.85rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-1);
    }

    .portal-subtitle {
      font-family: var(--font-noto-serif-devanagari);
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    .login-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: var(--space-6);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .login-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .field-label {
      font-family: var(--font-cinzel);
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--text-primary);
    }

    .input-field {
      width: 100%;
      padding: 0.75rem 1rem;
      font-family: var(--font-inter);
      font-size: 1rem;
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
      border-radius: 4px;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .input-field:focus {
      outline: none;
      border-color: var(--color-gold);
      box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.15);
    }

    .field-hint {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .error-banner {
      background: rgba(220, 38, 38, 0.1);
      border: 1px solid rgba(220, 38, 38, 0.3);
      color: #b91c1c;
      padding: 0.65rem 0.85rem;
      border-radius: 4px;
      font-size: 0.85rem;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: var(--color-gold);
      color: #fff;
      font-family: var(--font-cinzel);
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.85rem 1.5rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background var(--transition-fast), transform var(--transition-fast);
    }

    .btn-primary:hover {
      background: #966f07;
      transform: translateY(-1px);
    }

    .security-notice {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      margin-top: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-subtle);
      font-size: 0.8rem;
      line-height: 1.4;
      color: var(--text-muted);
    }

    .notice-icon {
      color: var(--color-gold);
      flex-shrink: 0;
      margin-top: 2px;
    }
  </style>

  <script is:inline>
    const form = document.getElementById('loginForm');
    const errorBox = document.getElementById('errorMessage');
    const submitBtn = document.getElementById('submitBtn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorBox.style.display = 'none';
        submitBtn.disabled = true;
        submitBtn.querySelector('span').textContent = 'Verifying...';

        const password = document.getElementById('adminPassword').value;

        try {
          const res = await fetch('/api/admin/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password })
          });

          const data = await res.json();

          if (res.ok && data.success) {
            // Store token in localStorage as backup header authorization
            if (data.token) {
              localStorage.setItem('ag_admin_token', data.token);
            }
            window.location.href = '/admin';
          } else {
            errorBox.textContent = data.error || 'Authentication rejected. Incorrect passphrase.';
            errorBox.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.querySelector('span').textContent = 'Unlock Editorial Suite';
          }
        } catch (err) {
          errorBox.textContent = 'Network or server communication error. Please try again.';
          errorBox.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.querySelector('span').textContent = 'Unlock Editorial Suite';
        }
      });
    }
  </script>
</BaseLayout>
