---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FontSizer from '../../../components/FontSizer.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import ArtworkModal from '../../../components/ArtworkModal.astro';
import { verifyAdminAuth } from '../../../lib/auth/adminAuth.ts';
import { getAdminWorkBySlug } from '../../../lib/content/adminService.ts';

export const prerender = false;

// Verify Owner Authentication
const auth = verifyAdminAuth(Astro.request);
if (!auth.authorized) {
  return Astro.redirect('/admin/login');
}

const { slug } = Astro.params;
const work = getAdminWorkBySlug(slug as string);

if (!work) {
  return new Response("Draft work not found", { status: 404 });
}

const editUrl = work.contentType === 'artwork'
  ? `/admin/editor/artwork?id=${work.id}`
  : `/admin/editor/writing?id=${work.id}`;

const isPoetry = work.contentType === 'poem';
const isArtwork = work.contentType === 'artwork';
const isHindi = work.language === 'hi' || work.script === 'Deva';
---

<BaseLayout 
  title={`[Preview] ${work.title} — Antigravity Review`}
  description={work.excerpt}
  image={work.coverImage}
  lang={work.language === 'mixed' ? 'en' : work.language}
  type="article"
>
  <!-- Sticky Admin Editorial Banner -->
  <aside class="admin-preview-banner" role="banner" aria-label="Editorial Preview Banner">
    <div class="banner-inner">
      <div class="banner-status-info">
        <span class="preview-badge">🔒 Private Reading Canvas</span>
        <span class={`status-pill pill-${work.status}`}>
          Status: {work.status.toUpperCase()}
        </span>
        <span class="type-pill">{work.contentType.toUpperCase()}</span>
      </div>

      <div class="banner-controls">
        <a href="/admin" class="btn-banner-link">Dashboard</a>
        <a href={editUrl} class="btn-banner-link btn-edit">Edit Work</a>
        {work.status !== 'published' ? (
          <button id="bannerPublishBtn" class="btn-banner-action btn-pub" data-id={work.id}>
            Publish to Public Site
          </button>
        ) : (
          <button id="bannerArchiveBtn" class="btn-banner-action btn-arch" data-id={work.id}>
            Withdraw (Archive)
          </button>
        )}
      </div>
    </div>
  </aside>

  <!-- Reading Canvas identical to public single post template -->
  <article class={`reading-canvas ${isHindi ? 'hindi-body' : 'english-body'}`} id="readingContent">
    <!-- Breadcrumb & Reader Controls Bar -->
    <div class="reader-meta-bar">
      <div class="meta-breadcrumb">
        <a href="/admin">Dashboard</a>
        <span class="separator">/</span>
        <span>Preview</span>
        <span class="separator">/</span>
        <span class="active-crumb">{work.contentType}</span>
      </div>

      <div class="reader-tools">
        <FontSizer targetSelector="#readingContent" />
        <ThemeToggle />
      </div>
    </div>

    <!-- Header Section -->
    <header class="work-header">
      <div class="category-meta">
        <span class="category-tag">{work.contentType.toUpperCase()}</span>
        <span class="lang-tag">{work.language.toUpperCase()}-{work.script}</span>
        {work.readingTimeMinutes && (
          <span class="reading-time">{work.readingTimeMinutes} min read</span>
        )}
      </div>

      <h1 class={`work-title ${isHindi ? 'title-devanagari' : 'title-serif'}`}>
        {work.title}
      </h1>

      <div class="work-byline">
        <span class="creator-name">By {work.creator}</span>
        <span class="dot-separator">•</span>
        <time datetime={work.publishedAt}>
          {new Date(work.publishedAt).toLocaleDateString(work.language === 'hi' ? 'hi-IN' : 'en-GB', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span class="dot-separator">•</span>
        <span class="rights-tag">{work.rights.status}</span>
      </div>

      {work.excerpt && (
        <p class="work-excerpt">{work.excerpt}</p>
      )}

      {/* Bilingual Companion Link if linked */}
      {work.translatedEditionSlug && (
        <div class="translation-companion-bar">
          <span class="companion-icon">⇄</span>
          <span>Bilingual Companion Edition Available:</span>
          <a href={`/admin/preview/${work.translatedEditionSlug}`} class="companion-link">
            {work.translatedEditionTitle || work.translatedEditionSlug}
          </a>
        </div>
      )}
    </header>

    <!-- Visual Artwork Presentation -->
    {isArtwork && work.coverImage && (
      <figure class="artwork-presentation">
        <div 
          class="artwork-frame cursor-zoom" 
          id="artworkViewerTrigger"
          data-image-src={work.coverImage}
          data-title={work.title}
          data-creator={work.creator}
          data-medium={work.artworkDetails?.medium || ''}
          data-dimensions={work.artworkDetails?.dimensions || ''}
          data-year={work.artworkDetails?.yearCreated || ''}
          data-alt={work.coverAlt || work.title}
          data-rights={work.rights.notice}
        >
          <img 
            src={work.coverImage} 
            alt={work.coverAlt || work.title} 
            class="artwork-image" 
            loading="eager"
          />
          <div class="zoom-cue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="11" y1="8" x2="11" y2="14"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
            <span>Click to Inspect High Resolution</span>
          </div>
        </div>

        <figcaption class="artwork-caption">
          <div class="caption-details">
            <span class="caption-medium">{work.artworkDetails?.medium}</span>
            <span class="caption-dim">{work.artworkDetails?.dimensions} • {work.artworkDetails?.yearCreated}</span>
          </div>
          <span class="caption-ratio">Aspect Ratio: {work.artworkDetails?.aspectRatio}</span>
        </figcaption>
      </figure>
    )}

    <!-- Literary Body Text -->
    {work.body && (
      <div class={`work-body ${isPoetry ? 'poetry-body' : 'prose-body'}`}>
        {work.body}
      </div>
    )}

    <!-- Quotation Citation Box (If quote) -->
    {work.contentType === 'quote' && work.quoteSource && (
      <div class="quote-citation-box">
        <h4 class="citation-heading">Bibliographic Source Citation</h4>
        <p class="citation-text">
          Source: <em>{work.quoteSource.workTitle}</em> by <strong>{work.quoteSource.author}</strong> ({work.quoteSource.year || 'Historical'}).
        </p>
        {work.quoteSource.url && (
          <p class="citation-link">
            Reference link: <a href={work.quoteSource.url} target="_blank" rel="noopener">{work.quoteSource.url}</a>
          </p>
        )}
        <div class="citation-badge">
          {work.quoteSource.isVerified ? '✓ Bibliographically Verified' : 'Citation Pending Verification'}
        </div>
      </div>
    )}

    <!-- Rights & Provenance Footer Section -->
    <footer class="work-footer-meta">
      <div class="rights-card">
        <h4 class="rights-heading">Legal Rights & Provenance Notice</h4>
        <p class="rights-notice-text">{work.rights.notice}</p>
        <div class="rights-badges">
          <span class="badge-chip">Declaration: {work.rights.declarationType}</span>
          <span class="badge-chip">Status: {work.rights.status}</span>
          <span class="badge-chip">Declared by: {work.rights.declaredBy}</span>
        </div>
      </div>

      <!-- Private Evidence Reference (Owner Only) -->
      {work.rights.privateEvidenceRef && (
        <div class="private-panel evidence-panel">
          <div class="panel-icon">🔒</div>
          <div class="panel-content">
            <strong>Confidential Provenance Reference (Owner Only):</strong>
            <code>{work.rights.privateEvidenceRef}</code>
            <p class="panel-disclaimer">This identifier is strictly quarantined from public reader responses.</p>
          </div>
        </div>
      )}

      <!-- Private Editorial Notes (Owner Only) -->
      {work.internalNotes && (
        <div class="private-panel notes-panel">
          <div class="panel-icon">📝</div>
          <div class="panel-content">
            <strong>Private Editorial Notes (Owner Only):</strong>
            <p class="notes-content">{work.internalNotes}</p>
            <p class="panel-disclaimer">Never transmitted to public website visitors or edge CDN assets.</p>
          </div>
        </div>
      )}
    </footer>
  </article>

  <ArtworkModal />

  <style>
    /* Sticky Admin Banner */
    .admin-preview-banner {
      position: sticky;
      top: 0;
      z-index: 999;
      background: #0f172a;
      color: #f8fafc;
      border-bottom: 2px solid var(--color-gold);
      padding: 0.6rem var(--space-4);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .banner-inner {
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .banner-status-info {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .preview-badge {
      font-family: var(--font-cinzel);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-gold);
    }

    .status-pill {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
    }

    .pill-published { background: #166534; color: #dcfce7; }
    .pill-draft { background: #92400e; color: #fef3c7; }
    .pill-archived { background: #334155; color: #e2e8f0; }

    .type-pill {
      font-size: 0.65rem;
      background: #1e293b;
      color: #94a3b8;
      padding: 0.2rem 0.4rem;
      border-radius: 3px;
    }

    .banner-controls {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-banner-link {
      font-family: var(--font-cinzel);
      font-size: 0.75rem;
      color: #e2e8f0;
      text-decoration: none;
      padding: 0.35rem 0.75rem;
      border: 1px solid #334155;
      border-radius: 4px;
      transition: all var(--transition-fast);
    }

    .btn-banner-link:hover {
      border-color: var(--color-gold);
      color: var(--color-gold);
    }

    .btn-edit {
      background: rgba(184, 134, 11, 0.2);
      border-color: var(--color-gold);
      color: var(--color-gold);
    }

    .btn-banner-action {
      font-family: var(--font-cinzel);
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      padding: 0.4rem 0.85rem;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      transition: background var(--transition-fast);
    }

    .btn-pub {
      background: #15803d;
      color: #fff;
    }
    .btn-pub:hover { background: #166534; }

    .btn-arch {
      background: #64748b;
      color: #fff;
    }
    .btn-arch:hover { background: #475569; }

    /* Reading Canvas */
    .reading-canvas {
      max-width: 820px;
      margin: 0 auto;
      padding: var(--space-6) var(--space-4) var(--space-16);
    }

    .reader-meta-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-8);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--border-subtle);
    }

    .meta-breadcrumb {
      font-family: var(--font-cinzel);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .meta-breadcrumb a {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .meta-breadcrumb a:hover {
      color: var(--color-gold);
    }

    .separator {
      margin: 0 0.4rem;
    }

    .active-crumb {
      color: var(--color-gold);
    }

    .reader-tools {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .work-header {
      margin-bottom: var(--space-8);
      text-align: center;
    }

    .category-meta {
      display: flex;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: var(--space-3);
    }

    .category-tag {
      font-family: var(--font-cinzel);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--color-gold);
      text-transform: uppercase;
    }

    .lang-tag, .reading-time {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .work-title {
      font-size: 2.4rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-3);
      line-height: 1.25;
    }

    .title-devanagari {
      font-family: var(--font-noto-serif-devanagari);
      line-height: 1.4;
    }

    .title-serif {
      font-family: var(--font-playfair);
    }

    .work-byline {
      font-size: 0.9rem;
      color: var(--text-secondary);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: var(--space-5);
      flex-wrap: wrap;
    }

    .creator-name {
      font-weight: 600;
      color: var(--text-primary);
    }

    .rights-tag {
      font-size: 0.75rem;
      color: var(--color-gold);
      border: 1px solid var(--border-subtle);
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
    }

    .work-excerpt {
      font-family: var(--font-newsreader);
      font-size: 1.2rem;
      font-style: italic;
      line-height: 1.6;
      color: var(--text-secondary);
      max-width: 680px;
      margin: 0 auto;
    }

    .translation-companion-bar {
      margin-top: var(--space-4);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 4px;
      padding: 0.4rem 0.85rem;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .companion-link {
      color: var(--color-gold);
      font-weight: 600;
      text-decoration: underline;
    }

    /* Artwork View */
    .artwork-presentation {
      margin-bottom: var(--space-10);
    }

    .artwork-frame {
      position: relative;
      background: #000;
      border-radius: 4px;
      overflow: hidden;
      display: flex;
      justify-content: center;
      cursor: zoom-in;
    }

    .artwork-image {
      max-width: 100%;
      height: auto;
      max-height: 650px;
      object-fit: contain;
    }

    .zoom-cue {
      position: absolute;
      bottom: var(--space-3);
      right: var(--space-3);
      background: rgba(0, 0, 0, 0.75);
      color: #fff;
      padding: 0.4rem 0.75rem;
      border-radius: 4px;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      backdrop-filter: blur(4px);
    }

    .artwork-caption {
      display: flex;
      justify-content: space-between;
      margin-top: var(--space-2);
      font-size: 0.85rem;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* Body Text & Whitespace Preservation */
    .work-body {
      font-size: var(--body-scale, 1.15rem);
      color: var(--text-primary);
      margin-bottom: var(--space-12);
    }

    .poetry-body {
      white-space: pre-wrap;
      word-break: break-word;
      font-family: var(--font-noto-serif-devanagari), Georgia, serif;
      line-height: 1.85;
      padding-left: var(--space-4);
      border-left: 2px solid var(--border-subtle);
    }

    .prose-body {
      font-family: var(--font-newsreader), Georgia, serif;
      line-height: 1.8;
      white-space: pre-line;
    }

    /* Quote Box */
    .quote-citation-box {
      background: var(--bg-surface);
      border-left: 3px solid var(--color-gold);
      padding: var(--space-4);
      border-radius: 0 4px 4px 0;
      margin-bottom: var(--space-8);
    }

    .citation-heading {
      font-family: var(--font-cinzel);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-gold);
      margin-bottom: var(--space-2);
    }

    .citation-badge {
      font-size: 0.75rem;
      color: #15803d;
      margin-top: var(--space-2);
    }

    /* Footer Meta & Private Panels */
    .work-footer-meta {
      border-top: 1px solid var(--border-subtle);
      padding-top: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .rights-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
      padding: var(--space-4);
    }

    .rights-heading {
      font-family: var(--font-cinzel);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: var(--space-2);
    }

    .rights-notice-text {
      font-size: 0.85rem;
      color: var(--text-primary);
      margin-bottom: var(--space-3);
    }

    .rights-badges {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .badge-chip {
      font-size: 0.75rem;
      background: rgba(184, 134, 11, 0.08);
      color: var(--color-gold);
      border: 1px solid rgba(184, 134, 11, 0.2);
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
    }

    .private-panel {
      display: flex;
      gap: var(--space-3);
      padding: var(--space-4);
      border-radius: 6px;
      font-size: 0.85rem;
      align-items: flex-start;
    }

    .evidence-panel {
      background: #fefce8;
      border: 1px solid #fef08a;
      color: #854d0e;
    }

    .notes-panel {
      background: #f5f3ff;
      border: 1px solid #ddd6fe;
      color: #5b21b6;
    }

    .panel-icon {
      font-size: 1.25rem;
    }

    .panel-disclaimer {
      font-size: 0.75rem;
      margin-top: 0.35rem;
      opacity: 0.85;
      font-style: italic;
    }

    .notes-content {
      margin-top: 0.25rem;
      white-space: pre-wrap;
    }
  </style>

  <script is:inline>
    // Quick Publish / Archive from Preview Banner
    const pubBtn = document.getElementById('bannerPublishBtn');
    if (pubBtn) {
      pubBtn.addEventListener('click', async () => {
        const id = pubBtn.getAttribute('data-id');
        pubBtn.disabled = true;
        pubBtn.textContent = 'Publishing...';
        const res = await fetch(`/api/admin/works/${id}/publish`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('Work successfully published to the live public journal!');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to publish.');
          pubBtn.disabled = false;
          pubBtn.textContent = 'Publish to Public Site';
        }
      });
    }

    const archBtn = document.getElementById('bannerArchiveBtn');
    if (archBtn) {
      archBtn.addEventListener('click', async () => {
        const id = archBtn.getAttribute('data-id');
        archBtn.disabled = true;
        archBtn.textContent = 'Archiving...';
        const res = await fetch(`/api/admin/works/${id}/archive`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('Work withdrawn and quarantined into archive.');
          window.location.reload();
        } else {
          alert(data.error || 'Failed to archive.');
          archBtn.disabled = false;
          archBtn.textContent = 'Withdraw (Archive)';
        }
      });
    }

    // Artwork Lightbox Modal trigger
    const trigger = document.getElementById('artworkViewerTrigger');
    if (trigger) {
      trigger.addEventListener('click', () => {
        const dialog = document.getElementById('artworkModal');
        if (dialog) {
          document.getElementById('modalImage').src = trigger.getAttribute('data-image-src');
          document.getElementById('modalImage').alt = trigger.getAttribute('data-alt');
          document.getElementById('modalTitle').textContent = trigger.getAttribute('data-title');
          document.getElementById('modalCreator').textContent = trigger.getAttribute('data-creator');
          document.getElementById('modalMedium').textContent = trigger.getAttribute('data-medium');
          document.getElementById('modalDimensions').textContent = trigger.getAttribute('data-dimensions');
          document.getElementById('modalYear').textContent = trigger.getAttribute('data-year');
          document.getElementById('modalRights').textContent = trigger.getAttribute('data-rights');
          dialog.showModal();
        }
      });
    }
  </script>
</BaseLayout>
